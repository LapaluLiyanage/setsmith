PORT=4000
# YouTube Data API v3 key (Google Cloud console). Needed for search and video length.
# Without it, pasted links still work through YouTube oEmbed (title only).
YOUTUBE_API_KEY=
# GetSongBPM API key (https://getsongbpm.com/api). Free, requires a backlink credit on the site.
GETSONGBPM_API_KEY=
GETSONGBPM_BASE_URL=https://api.getsong.co
